<UserControl x:Class="ATREUS.OperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#06151D">
    <Grid Margin="30,28,42,40"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Margin="0,0,0,22"><TextBlock x:Name="SectionLabel" Text="ATREUS · SUIVI OPÉRATIONNEL" Foreground="#C8A24A" FontSize="11" /><TextBlock x:Name="TitleLabel" Text="Incidents" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" /><TextBlock Text="Suivi des événements associés aux moyens du parc." Foreground="#A9BBC0" FontSize="13" /></StackPanel><Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><Grid Margin="0,0,0,16"><TextBlock x:Name="CountLabel" Foreground="#A9BBC0" /><Button Content="+ Nouvelle entrée" HorizontalAlignment="Right" Padding="12,6" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Click="AddClick" /></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="EntriesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0B222D" BorderBrush="#214451" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="180" /><ColumnDefinition /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15" /><TextBlock Grid.Column="1" Text="{Binding VehicleIdentifier}" Foreground="#A9BBC0" /><TextBlock Grid.Column="2" Text="{Binding Nature}" /><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#E2A05A" HorizontalAlignment="Right" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border></Grid>
</UserControl>
