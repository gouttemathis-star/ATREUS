<Window x:Class="ATREUS.AddVehicleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un véhicule" Width="620" Height="760" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#06151D" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#214451" /><Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9BBC0" /><Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="ATREUS · NOUVEAU VÉHICULE" Foreground="#C8A24A" FontSize="11" />
            <TextBlock Text="Ajouter un véhicule" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#0B222D" BorderBrush="#214451" BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock Text="IDENTIFICATION" Foreground="#C8A24A" FontSize="11" Margin="0,0,0,12" />
                    <TextBlock Text="Identifiant" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="IdentifierInput" Style="{StaticResource InputStyle}" />
                    <TextBlock Text="Description / usage" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="DescriptionInput" Style="{StaticResource InputStyle}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Type de véhicule" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="TypeInput" DisplayMemberPath="Display" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,10" SelectionChanged="TypeSelectionChanged" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="État / statut" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="StateInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,10"><ComboBoxItem Content="Disponible" /><ComboBoxItem Content="Maintenance" /><ComboBoxItem Content="Indisponible" /></ComboBox></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Marque" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="BrandInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Modèle" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="ModelInput" Style="{StaticResource InputStyle}" /></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Immatriculation / identifiant" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="PlateInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Kilométrage / heures" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="MileageInput" Style="{StaticResource InputStyle}" /></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Chauffeur associé" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="DriverInput" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" /></StackPanel>
                        <Button Grid.Column="2" Content="+ Chauffeur" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="10,7" Click="AddDriverClick" />
                    </Grid>
                    <TextBlock Text="Lieu (ville ou adresse)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="LocationInput" Style="{StaticResource InputStyle}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Latitude (décimale)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="LatitudeInput" Text="46.5" Style="{StaticResource InputStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Longitude (décimale)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="LongitudeInput" Text="2.35" Style="{StaticResource InputStyle}" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Padding="14,8" Margin="0,0,8,0" Click="CancelClick" />
            <Button Content="Ajouter le véhicule" Padding="14,8" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
