<Window x:Class="ATREUS.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tâche" Width="680" Height="790" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9BBC0" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
        <Style x:Key="InputStyle" TargetType="TextBox"><Setter Property="Background" Value="#06151D" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#214451" /><Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="ATREUS · SUIVI DES TÂCHES" Foreground="#C8A24A" FontSize="11" /><TextBlock x:Name="TitleLabel" Text="Nouvelle tâche" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#0B222D" BorderBrush="#214451" BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock Text="Intitulé" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="TitleInput" Style="{StaticResource InputStyle}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" /><DatePicker x:Name="DateInput" Margin="0,0,0,12" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Heure de début (HH:mm)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="TimeInput" Style="{StaticResource InputStyle}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Heure de fin (facultative, HH:mm)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="EndTimeInput" Style="{StaticResource InputStyle}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Priorité" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="PriorityInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12"><ComboBoxItem Content="Haute" /><ComboBoxItem Content="Normale" /><ComboBoxItem Content="Basse" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Statut" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="StatusInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12"><ComboBoxItem Content="À faire" /><ComboBoxItem Content="En cours" /><ComboBoxItem Content="Terminée" /><ComboBoxItem Content="Annulée" /></ComboBox></StackPanel>
                    </Grid>
                    <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="DescriptionInput" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource InputStyle}" />
                    <TextBlock Text="Véhicule associé" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="VehicleInput" DisplayMemberPath="Identifier" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12" SelectionChanged="VehicleSelectionChanged" />
                    <TextBlock Text="Chauffeur associé" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="DriverInput" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12" />
                    <TextBlock Text="Incident / maintenance / trajet associé" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="OperationInput" DisplayMemberPath="Display" SelectedValuePath="Operation.Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,4" SelectionChanged="OperationSelectionChanged" />
                    <Button x:Name="OperationLinkButton" Content="Ouvrir l’opération associée" HorizontalAlignment="Right" Padding="9,5" Margin="0,0,0,4" Click="OpenOperationClick" />
                </StackPanel>
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Annuler" Padding="14,8" Margin="0,0,8,0" Click="CancelClick" /><Button Content="Enregistrer" Padding="14,8" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Click="SaveClick" /></StackPanel>
    </Grid>
</Window>
