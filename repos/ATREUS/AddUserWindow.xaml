<Window x:Class="ATREUS.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un compte" Width="550" Height="780" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ATREUS · ACCÈS UTILISATEUR" Foreground="#C8A24A" FontSize="11" />
            <TextBlock x:Name="WindowHeading" Text="Créer un compte" FontSize="25" FontWeight="Bold" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1"
                CornerRadius="9" Padding="17" Margin="0,18,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nom affiché" Margin="0,0,0,5" />
                    <TextBox x:Name="DisplayNameInput" Margin="0,0,0,12" Padding="10,8" />
                    <TextBlock Text="Identifiant de connexion" Margin="0,0,0,5" />
                    <TextBox x:Name="UserNameInput" Margin="0,0,0,12" Padding="10,8" />
                    <TextBlock Text="Rôle" Margin="0,0,0,5" />
                    <ComboBox x:Name="RoleInput" DisplayMemberPath="Display" Margin="0,0,0,5" Padding="10,7"
                              SelectionChanged="RoleChanged" />
                    <TextBlock x:Name="RoleDescriptionLabel" Foreground="#A9BBC0"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Niveau d’accréditation" Margin="0,0,0,5" />
                    <ComboBox x:Name="AccessLevelInput" Margin="0,0,0,5" Padding="10,7"
                              SelectionChanged="AccessLevelChanged" />
                    <TextBlock x:Name="AccessDescriptionLabel" Foreground="#A9BBC0"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock x:Name="DriverLabel" Text="Fiche chauffeur liée au planning personnel (facultatif)"
                               Margin="0,0,0,5" Visibility="Collapsed" />
                    <ComboBox x:Name="DriverInput" DisplayMemberPath="Name" SelectedValuePath="Id"
                              Margin="0,0,0,12" Padding="10,7" Visibility="Collapsed" />
                    <Border x:Name="CustomPermissionsPanel" Background="#081A23"
                            BorderBrush="#214451" BorderThickness="1" CornerRadius="7"
                            Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Autorisations personnalisées" Foreground="#C8A24A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <CheckBox x:Name="DashboardPermission" Content="Tableau de bord" Margin="0,3" />
                                <CheckBox x:Name="FleetPermission" Content="Consulter le parc matériel" Margin="0,3" />
                                <CheckBox x:Name="IncidentsPermission" Content="Consulter les incidents" Margin="0,3" />
                                <CheckBox x:Name="MaintenancePermission" Content="Consulter les maintenances" Margin="0,3" />
                                <CheckBox x:Name="MapPermission" Content="Accéder à ATREMAPS" Margin="0,3" />
                                <CheckBox x:Name="PersonalCalendarPermission" Content="Planning personnel uniquement"
                                          Margin="0,3" Checked="PersonalCalendarChanged" Unchecked="PersonalCalendarChanged" />
                                <CheckBox x:Name="GroupCalendarPermission" Content="Calendrier de groupe et trajets" Margin="0,3" />
                                <CheckBox x:Name="AssistantPermission" Content="Utiliser l’assistante ATREUS" Margin="0,3" />
                                <CheckBox x:Name="SavPermission" Content="Accéder au SAV" Margin="0,3" />
                                <CheckBox x:Name="CreateVehiclesPermission" Content="Ajouter des véhicules" Margin="0,3" />
                                <CheckBox x:Name="EditVehiclesPermission" Content="Modifier les fiches véhicules" Margin="0,3" />
                                <CheckBox x:Name="DeleteVehiclesPermission" Content="Supprimer des véhicules" Margin="0,3" />
                                <CheckBox x:Name="ManageIncidentsPermission" Content="Créer / modifier / supprimer des incidents" Margin="0,3" />
                                <CheckBox x:Name="ManageMaintenancePermission" Content="Créer / modifier / supprimer des maintenances" Margin="0,3" />
                                <CheckBox x:Name="ManageTasksPermission" Content="Créer / modifier / supprimer des tâches" Margin="0,3" />
                                <CheckBox x:Name="ManageTripsPermission" Content="Créer / modifier / supprimer des trajets" Margin="0,3" />
                                <CheckBox x:Name="ExportPermission" Content="Exporter les données" Margin="0,3" />
                                <CheckBox x:Name="ManageAccountsPermission" Content="Créer / gérer les comptes non protégés" Margin="0,3" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="Mot de passe (10 caractères minimum)" Margin="0,0,0,5" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" Padding="10,8" />
                    <TextBlock Text="Confirmer le mot de passe" Margin="0,0,0,5" />
                    <PasswordBox x:Name="ConfirmPasswordInput" Padding="10,8" />
                    <TextBlock x:Name="ErrorLabel" Foreground="#E28076" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Padding="14,8" Margin="0,0,9,0" Click="CancelClick" />
            <Button x:Name="SaveButton" Content="Créer le compte" Padding="15,8" Background="#C8A24A"
                    Foreground="#06151D" BorderThickness="0" FontWeight="SemiBold" Click="CreateClick" />
        </StackPanel>
    </Grid>
</Window>
