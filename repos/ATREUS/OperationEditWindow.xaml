<Window x:Class="ATREUS.OperationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opération" Width="650" Height="790" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9BBC0" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#06151D" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#214451" />
            <Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock x:Name="SectionLabel" Foreground="#C8A24A" FontSize="11" /><TextBlock x:Name="TitleLabel" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#0B222D" BorderBrush="#214451" BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock Text="VÉHICULE" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="VehicleInput" DisplayMemberPath="Identifier" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12" SelectionChanged="VehicleSelectionChanged" />
                    <TextBlock Text="CHAUFFEUR" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="DriverInput" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,6" SelectionChanged="DriverSelectionChanged" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12"><Button x:Name="VehicleLinkButton" Content="Ouvrir la fiche véhicule" Padding="9,5" Margin="0,0,6,0" Click="OpenVehicleClick" /><Button x:Name="DriverLinkButton" Content="Fiche chauffeur" Padding="9,5" Click="OpenDriverClick" /></StackPanel>
                    <StackPanel x:Name="RelatedTripPanel" Visibility="Collapsed">
                        <TextBlock Text="TRAJET ASSOCIÉ (pour un incident, facultatif)" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="TripInput" DisplayMemberPath="Number" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12" />
                    </StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" /><DatePicker x:Name="DateInput" Background="#06151D" Foreground="White" Margin="0,0,0,12" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock x:Name="TimeLabel" Text="Heure (facultative, HH:mm)" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="TimeInput" Style="{StaticResource InputStyle}" /></StackPanel>
                    </Grid>
                    <StackPanel x:Name="TripFieldsPanel" Visibility="Collapsed">
                        <TextBlock Text="Durée du trajet (HH:mm)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="DurationInput" Style="{StaticResource InputStyle}" ToolTip="Exemple : 02:30 pour un trajet de deux heures et trente minutes." />
                        <TextBlock Text="Destination" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="DestinationInput" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="LocationLabel" Text="Lieu" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="LocationInput" Style="{StaticResource InputStyle}" />
                    <TextBlock x:Name="NatureLabel" Text="Nature / objet" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="NatureInput" Style="{StaticResource InputStyle}" />
                    <TextBlock Text="Statut" Style="{StaticResource FieldLabelStyle}" /><ComboBox x:Name="StatusInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="8" Margin="0,0,0,12" />
                    <TextBlock Text="Informations complémentaires" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="DetailsInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource InputStyle}" />
                    <TextBlock Text="TÂCHES ASSOCIÉES" Foreground="#C8A24A" FontSize="10" Margin="0,8,0,8" />
                    <ItemsControl x:Name="RelatedTasksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Display}" Tag="{Binding Task}" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,0,0,5" Background="#06151D" Foreground="#E8EEF0" BorderBrush="#214451" Click="RelatedTaskClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoRelatedTasksLabel" Text="Aucune tâche liée." Foreground="#A9BBC0" FontSize="11" />
                </StackPanel>
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteTripButton" Content="Supprimer le trajet" Padding="14,8" Margin="0,0,8,0" Foreground="#E28076" Click="DeleteTripClick" Visibility="Collapsed" />
            <Button Content="Fermer" Padding="14,8" Margin="0,0,8,0" Click="CloseClick" />
            <Button Content="Enregistrer" Padding="14,8" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
