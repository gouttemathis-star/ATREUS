<Window x:Class="ATREUS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion ATREUS" Width="430" Height="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#06151D" Foreground="#E8EEF0">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ACCÈS SÉCURISÉ" Foreground="#C8A24A" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="Connexion à ATREUS" FontSize="26" FontWeight="Bold" Margin="0,7,0,2" />
            <TextBlock Text="Chaque rôle dispose uniquement des espaces correspondant à ses autorisations."
                       Foreground="#A9BBC0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1"
                CornerRadius="9" Padding="18" Margin="0,20,0,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Identifiant" Margin="0,0,0,5" />
                <TextBox x:Name="UserNameInput" Margin="0,0,0,15" Padding="10,8" KeyDown="InputKeyDown" />
                <TextBlock Text="Mot de passe" Margin="0,0,0,5" />
                <PasswordBox x:Name="PasswordInput" Padding="10,8" KeyDown="InputKeyDown" />
                <TextBlock x:Name="ErrorLabel" Foreground="#E28076" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Quitter" Padding="15,9" Margin="0,0,10,0" Click="CancelClick" />
            <Button Content="Se connecter" Padding="17,9" Background="#C8A24A"
                    Foreground="#06151D" BorderThickness="0" FontWeight="SemiBold" Click="LoginClick" />
        </StackPanel>
    </Grid>
</Window>
