<Window x:Class="ATREUS.AccountSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration initiale ATREUS" Width="510" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#06151D" Foreground="#E8EEF0">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ATREUS · PREMIÈRE UTILISATION" Foreground="#C8A24A" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="Créer le compte administrateur" FontSize="24" FontWeight="Bold" Margin="0,7,0,4" />
            <TextBlock Text="Ce compte gérera les accès et les rôles. Son mot de passe est conservé sous forme hachée sur cet appareil."
                       Foreground="#A9BBC0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1"
                CornerRadius="9" Padding="18" Margin="0,20,0,18">
            <StackPanel>
                <TextBlock Text="Nom affiché" Margin="0,0,0,5" />
                <TextBox x:Name="DisplayNameInput" Text="Administrateur ATREUS" Margin="0,0,0,13" Padding="10,8" />
                <TextBlock Text="Identifiant de connexion" Margin="0,0,0,5" />
                <TextBox x:Name="UserNameInput" Margin="0,0,0,13" Padding="10,8" />
                <TextBlock Text="Mot de passe (10 caractères minimum)" Margin="0,0,0,5" />
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,13" Padding="10,8" />
                <TextBlock Text="Confirmer le mot de passe" Margin="0,0,0,5" />
                <PasswordBox x:Name="ConfirmPasswordInput" Padding="10,8" />
                <TextBlock x:Name="ErrorLabel" Foreground="#E28076" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <Button Grid.Row="2" Content="Créer le compte" HorizontalAlignment="Right"
                Padding="17,9" Background="#C8A24A" Foreground="#06151D"
                BorderThickness="0" FontWeight="SemiBold" Click="CreateClick" />
    </Grid>
</Window>
