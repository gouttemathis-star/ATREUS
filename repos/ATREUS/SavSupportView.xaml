    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,28,42,40" MaxWidth="1120" HorizontalAlignment="Left">
            <TextBlock Text="M INDUSTRIE · SUPPORT" Foreground="{StaticResource GoldBrush}" FontSize="11" />
            <TextBlock Text="Support &amp; présentation" FontSize="34" FontWeight="Bold" Margin="0,7,0,20" />

            <Border Background="#080B0E" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18">
                <Image Source="/ATREUS;component/Assets/m-industrie-logo.png"
                       Height="220" Stretch="Uniform" />
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="M INDUSTRIE" Foreground="{StaticResource GoldBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="Des solutions pour demain."
                               FontSize="25" FontWeight="SemiBold" Margin="0,7,0,10" />
                    <TextBlock Text="M INDUSTRIE place la recherche et le développement au service de solutions utiles et innovantes, avec un intérêt particulier pour les enjeux de sécurité et de santé."
                               Foreground="{StaticResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" LineHeight="21" MaxWidth="850" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,10">
                            <StackPanel>
                                <Image Source="{StaticResource ResearchArt}" Height="120" Stretch="UniformToFill" />
                                <TextBlock Text="R&amp;D" Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold" Margin="4,9,4,0" />
                                <TextBlock Text="Recherche et développement" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,4,4,2" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Image Source="{StaticResource HealthArt}" Height="120" Stretch="UniformToFill" />
                                <TextBlock Text="SANTÉ" Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold" Margin="4,9,4,0" />
                                <TextBlock Text="Innovation au service de la santé" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,4,4,2" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                            <StackPanel>
                                <Image Source="{StaticResource SafetyArt}" Height="120" Stretch="UniformToFill" />
                                <TextBlock Text="SÉCURITÉ" Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold" Margin="4,9,4,0" />
                                <TextBlock Text="Des solutions pensées pour la sécurité" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,4,4,2" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <Image Source="{StaticResource DigitalArt}" Height="120" Stretch="UniformToFill" />
                                <TextBlock Text="INFORMATIQUE" Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold" Margin="4,9,4,0" />
                                <TextBlock Text="Technologies et solutions numériques" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,4,4,2" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="SERVICE APRÈS-VENTE" Foreground="{StaticResource GoldBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="Contacter le support" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,14" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,18,12">
                            <TextBlock Text="TÉLÉPHONE" Foreground="{StaticResource GoldBrush}" FontSize="9" />
                            <TextBlock Text="Coordonnée officielle à renseigner" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="E-MAIL" Foreground="{StaticResource GoldBrush}" FontSize="9" />
                            <TextBlock Text="Adresse officielle à renseigner" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12">
                            <TextBlock Text="HORAIRES DU SUPPORT" Foreground="{StaticResource GoldBrush}" FontSize="9" />
                            <TextBlock Text="Horaires officiels à renseigner" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="SITE INTERNET" Foreground="{StaticResource GoldBrush}" FontSize="9" />
                            <TextBlock Text="Lien officiel à renseigner" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,2,0,12" />
                    <TextBlock Text="RETROUVEZ M INDUSTRIE" Foreground="{StaticResource GoldBrush}"
                               FontSize="9" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Instagram" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="Lien officiel à renseigner" Foreground="{StaticResource MutedBrush}" Margin="0,0,26,0" />
                        <TextBlock Text="LinkedIn" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="Lien officiel à renseigner" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
