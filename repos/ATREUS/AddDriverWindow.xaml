<Window x:Class="ATREUS.AddDriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un chauffeur"
        Width="430" Height="350"
        WindowStartupLocation="CenterOwner"
        Background="#06151D" Foreground="#E8EEF0">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="ATREUS · NOUVEAU CHAUFFEUR" Foreground="#C8A24A" FontSize="11" />
            <TextBlock Text="Ajouter un chauffeur" FontSize="25" FontWeight="Bold" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Background="#0B222D" Margin="0" >
            <TextBlock Text="Nom complet" Foreground="#A9BBC0" Margin="12,12,12,5" />
            <TextBox x:Name="NameInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="10,8" Margin="12,0,12,12" />
            <TextBlock Text="Téléphone (facultatif)" Foreground="#A9BBC0" Margin="12,0,12,5" />
            <TextBox x:Name="PhoneInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="10,8" Margin="12,0,12,12" />
            <TextBlock Text="Informations complémentaires" Foreground="#A9BBC0" Margin="12,0,12,5" />
            <TextBox x:Name="NotesInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="10,8" Margin="12,0,12,12" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Padding="14,8" Margin="0,0,8,0" Click="CancelClick" />
            <Button Content="Ajouter" Padding="14,8" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
