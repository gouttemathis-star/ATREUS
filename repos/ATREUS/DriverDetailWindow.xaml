<Window x:Class="ATREUS.DriverDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiche chauffeur" Width="700" Height="620" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="ATREUS · FICHE CHAUFFEUR" Foreground="#C8A24A" FontSize="11" />
            <TextBlock x:Name="NameLabel" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
            <TextBlock x:Name="PhoneLabel" Foreground="#A9BBC0" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <TextBlock x:Name="NotesLabel" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="2" Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="VÉHICULES ASSOCIÉS" Foreground="#C8A24A" FontSize="11" Margin="0,0,0,10" />
                <ItemsControl x:Name="VehiclesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Display}" Tag="{Binding Vehicle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,6" Background="#0B222D" Foreground="#E8EEF0" BorderBrush="#214451" Click="VehicleClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyLabel" Text="Aucun véhicule associé." Foreground="#A9BBC0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="OPÉRATIONS ASSOCIÉES" Foreground="#C8A24A" FontSize="11" Margin="0,0,0,10" />
                <ItemsControl x:Name="OperationsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Display}" Tag="{Binding Operation}" HorizontalContentAlignment="Left" Padding="9,7" Margin="0,0,0,5" Background="#0B222D" Foreground="#E8EEF0" BorderBrush="#214451" Click="OperationClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyOperationsLabel" Text="Aucune opération associée." Foreground="#A9BBC0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Button Grid.Row="4" Content="Fermer" HorizontalAlignment="Right" Padding="14,8" Margin="0,16,0,0" Click="CloseClick" />
    </Grid>
</Window>
