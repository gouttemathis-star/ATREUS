<Window x:Class="ATREUS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ATREUS"
        mc:Ignorable="d"
        Title="ATREUS - Tableau de bord"
        Icon="/ATREUS;component/Assets/atreus.ico"
        Height="900"
        Width="1440"
        MinHeight="720"
        MinWidth="1100"
        Background="#06151D"
        Foreground="#E8EEF0"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#06151D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#091D27" />
        <SolidColorBrush x:Key="CardBrush" Color="#0B222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#214451" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BBC0" />
        <SolidColorBrush x:Key="GoldBrush" Color="#C8A24A" />
        <SolidColorBrush x:Key="GreenBrush" Color="#7CCB9B" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#E2A05A" />

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B5C5C9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="FilterStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#F1F5F6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ToggleButton Width="42" HorizontalAlignment="Right" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="⌄" Foreground="{TemplateBinding Foreground}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#000000" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F1F5F6" />
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#000000" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#172A31" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#071923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,26">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,4">
                        <Border Width="38" Height="46" Background="#12313C" Margin="0,0,12,0" Clip="M 0,0 L 38,8 L 38,38 L 0,46 Z">
                            <TextBlock Text="✦" Foreground="#E5C35B" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ATREUS" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Foreground="#E8E6DA" />
                    </StackPanel>
                    <TextBlock Text="DEFENCE ASSET" Margin="52,0,0,0" FontSize="9" Foreground="#A9BBC0" />
                    <TextBlock Text="MANAGEMENT" Margin="52,2,0,0" FontSize="9" Foreground="#A9BBC0" />
                    <TextBlock Text="M INDUSTRIE" Margin="52,13,0,0" FontSize="10" Foreground="#A9BBC0" />
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,28,0,25" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="PILOTAGE" FontSize="10" Foreground="#52707A" Margin="14,8,0,10" />
                    <Button x:Name="DashboardNavButton" Style="{StaticResource NavItemStyle}" Content="▣  Tableau de bord" Click="DashboardClick" />
                    <Button x:Name="MapNavButton" Style="{StaticResource NavItemStyle}" Content="↕  Carte opérationnelle" Click="MapClick" />
                    <Button x:Name="UnitsNavButton" Style="{StaticResource NavItemStyle}" Content="♜  Régiments" Click="UnitsClick" />
                    <TextBlock Text="PARC &amp; MAINTENANCE" FontSize="10" Foreground="#52707A" Margin="14,28,0,10" />
                    <Button x:Name="MaterialNavButton" Style="{StaticResource NavItemStyle}" Content="▤  Parc matériel" Click="MaterialClick" />
                    <Button x:Name="IncidentsNavButton" Style="{StaticResource NavItemStyle}" Content="⚠  Incidents" Click="IncidentsClick" />
                    <Button x:Name="MaintenanceNavButton" Style="{StaticResource NavItemStyle}" Content="⚙  Maintenance" Click="MaintenanceClick" />
                    <Button Style="{StaticResource NavItemStyle}" Content="◷  Historique" />
                    <TextBlock Text="ASSISTANCE" FontSize="10" Foreground="#52707A" Margin="14,28,0,10" />
                    <Button Style="{StaticResource NavItemStyle}" Content="◌  Support ATREUS" />
                    <Button Style="{StaticResource NavItemStyle}" Content="♧  SAV" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
        <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,28,42,40">
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="ATREUS · CENTRE DE PILOTAGE" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                        <TextBlock Text="Tableau de bord" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="Démonstration — données et unités fictives." Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        <Grid Margin="0,16,0,0">
                            <TextBox x:Name="SearchInput" Width="360" Height="38" HorizontalAlignment="Left" TextChanged="SearchChanged" ToolTip="Rechercher un véhicule" Background="#0A202A" Foreground="#A9BBC0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Exporter CSV" Padding="12,7" Background="{StaticResource GoldBrush}" Foreground="#06151D" BorderThickness="0" Click="ExportCsvClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                        <TextBlock Text="SYSTÈME DÉMO" Foreground="#D9B85A" FontSize="10" />
                    </Border>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18,20,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PARC SÉLECTIONNÉ" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                                <TextBlock Text="12e Régiment Orion" FontSize="23" FontWeight="Bold" Margin="0,3,0,2" />
                                <TextBlock Text="Armée de Terre · Données fictives de démonstration" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                                <TextBlock Text="PARC MATÉRIEL" Foreground="#D9B85A" FontSize="10" />
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#081A23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ÉTAT DU PARC" Foreground="{StaticResource GoldBrush}" FontSize="11" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions><TextBlock Text="Véhicules référencés" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding ReferenceCount}" HorizontalAlignment="Right" /></Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions><TextBlock Text="Disponibles" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding AvailableCount}" HorizontalAlignment="Right" Foreground="{StaticResource GreenBrush}" /></Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions><TextBlock Text="En maintenance" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding MaintenanceCount}" HorizontalAlignment="Right" Foreground="{StaticResource OrangeBrush}" /></Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions><TextBlock Text="Indisponibles" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding UnavailableCount}" HorizontalAlignment="Right" /></Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#081A23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                                <StackPanel>
                                    <Grid Margin="4,0,0,12">
                                        <TextBlock Text="VÉHICULES DU PARC" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                                        <Button Content="+ Ajouter" HorizontalAlignment="Right" Padding="10,4" Background="#0B222D" Foreground="#FFFFFF" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Click="AddVehicleClick" />
                                    </Grid>
                                    <ComboBox x:Name="TypeFilter" Style="{StaticResource FilterStyle}" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Tous les types" /><ComboBoxItem Content="Terrestre" /><ComboBoxItem Content="Aérien" /><ComboBoxItem Content="Maritime" /></ComboBox>
                                    <ComboBox x:Name="StateFilter" Style="{StaticResource FilterStyle}" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Tous les états" /><ComboBoxItem Content="Disponible" /><ComboBoxItem Content="Maintenance" /><ComboBoxItem Content="Indisponible" /></ComboBox>
                                    <ItemsControl x:Name="VehicleList" ItemsSource="{Binding VisibleVehicles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="VehicleDoubleClick">
                                                    <StackPanel>
                                                        <Grid><TextBlock Text="{Binding Identifier}" FontWeight="Bold" FontSize="12" /><TextBlock Text="{Binding State}" HorizontalAlignment="Right" FontSize="11" Foreground="{Binding StateColor}" /></Grid>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="{Binding ReferenceCount}" FontSize="32" FontWeight="Bold" /><TextBlock Text="ÉQUIPEMENTS RÉFÉRENCÉS" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="{Binding AvailableCount}" FontSize="32" FontWeight="Bold" /><TextBlock Text="OPÉRATIONNELS" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                    <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="{Binding MaintenanceCount}" FontSize="32" FontWeight="Bold" /><TextBlock Text="EN MAINTENANCE" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel></Border>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="DISPONIBILITÉ DU PARC" Foreground="{StaticResource GoldBrush}" FontSize="11" /><TextBlock Text="{Binding AvailabilityPercentage}" FontSize="38" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="véhicules opérationnels" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><Grid><TextBlock Text="ALERTES PRIORITAIRES" Foreground="{StaticResource GoldBrush}" FontSize="11" /><TextBlock Text="{Binding AlertCount}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}" /></Grid><ItemsControl ItemsSource="{Binding AlertVehicles}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Identifier}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,6,0" /><TextBlock Text="{Binding State}" Foreground="{StaticResource OrangeBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="UnitsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,28,42,40">
                <TextBlock Text="ATREUS · ORGANISATION" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                <TextBlock Text="Régiments et unités" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" />
                <TextBlock Text="Structure des unités et rattachement des moyens." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,24" />
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16"><TextBlock Text="UNITÉS RÉFÉRENCÉES" Foreground="{StaticResource GoldBrush}" FontSize="11" /><Button Content="+ Ajouter une unité" HorizontalAlignment="Right" Padding="12,6" Background="{StaticResource GoldBrush}" Foreground="#06151D" BorderThickness="0" Click="AddUnitClick" /></Grid>
                        <ItemsControl ItemsSource="{Binding Units}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="EFFECTIF" Foreground="{StaticResource GoldBrush}" FontSize="10" /><TextBlock Text="{Binding PersonnelCount}" FontSize="18" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="VÉHICULES" Foreground="{StaticResource GoldBrush}" FontSize="10" /><TextBlock Text="{Binding VehicleCount}" FontSize="18" Margin="0,5,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <local:MaterialView x:Name="MaterialView" Visibility="Collapsed" />
        <local:OperationsView x:Name="OperationsView" Visibility="Collapsed" />
        <local:MapView x:Name="EmbeddedMapView" Visibility="Collapsed" />
    </Grid>
        </Grid>
</Window>
