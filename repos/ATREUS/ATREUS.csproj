<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\atreus.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2">
      <Version>1.0.4258.31</Version>
    </PackageReference>
    <Resource Include="Assets\atreus.ico" />
    <Resource Include="Assets\atreus-logo.png" />
    <Resource Include="Assets\atreus-industrial-emblem.jpg" />
    <Resource Include="Assets\atreus-assistant.png" />
    <Content Include="GlobeMap.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
