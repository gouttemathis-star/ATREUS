<Window x:Class="ATREUS.VehicleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiche véhicule" Width="1080" Height="820" MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#06151D" /><Setter Property="Foreground" Value="#E8EEF0" />
            <Setter Property="BorderBrush" Value="#214451" /><Setter Property="Padding" Value="9,7" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9BBC0" /><Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ATREUS · FICHE VÉHICULE" Foreground="#C8A24A" FontSize="11" />
                <TextBlock x:Name="TitleLabel" FontSize="27" FontWeight="Bold" Margin="0,5,0,2" />
                <TextBlock x:Name="DriverLabel" Foreground="#A9BBC0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="DriverButton" Content="Fiche chauffeur" Padding="12,7" Margin="0,0,8,0" Click="DriverClick" />
                <Button x:Name="EditButton" Content="Modifier" Padding="14,7" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Click="EditClick" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="IDENTIFICATION ET AFFECTATION" Foreground="#C8A24A" FontSize="11" Margin="0,0,0,14" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Identifiant" Style="{StaticResource LabelStyle}" /><TextBox x:Name="IdentifierInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Description / usage" Style="{StaticResource LabelStyle}" /><TextBox x:Name="DescriptionInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="État" Style="{StaticResource LabelStyle}" /><ComboBox x:Name="StateInput" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="7" IsEnabled="False"><ComboBoxItem Content="Disponible" /><ComboBoxItem Content="Maintenance" /><ComboBoxItem Content="Indisponible" /></ComboBox></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Type de véhicule" Style="{StaticResource LabelStyle}" /><ComboBox x:Name="TypeInput" DisplayMemberPath="Display" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="7" IsEnabled="False" SelectionChanged="TypeSelectionChanged" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Marque" Style="{StaticResource LabelStyle}" /><TextBox x:Name="BrandInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Modèle" Style="{StaticResource LabelStyle}" /><TextBox x:Name="ModelInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Immatriculation / identifiant" Style="{StaticResource LabelStyle}" /><TextBox x:Name="PlateInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Kilométrage / heures" Style="{StaticResource LabelStyle}" /><TextBox x:Name="MileageInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Chauffeur" Style="{StaticResource LabelStyle}" /><ComboBox x:Name="DriverInput" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#06151D" Foreground="White" BorderBrush="#214451" Padding="7" IsEnabled="False" /></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Lieu / ville" Style="{StaticResource LabelStyle}" /><TextBox x:Name="LocationInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Latitude" Style="{StaticResource LabelStyle}" /><TextBox x:Name="LatitudeInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Longitude" Style="{StaticResource LabelStyle}" /><TextBox x:Name="LongitudeInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Énergie" Style="{StaticResource LabelStyle}" /><TextBox x:Name="EnergyInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Puissance" Style="{StaticResource LabelStyle}" /><TextBox x:Name="PowerInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Prochain contrôle" Style="{StaticResource LabelStyle}" /><TextBox x:Name="NextInspectionInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Carte grise" Style="{StaticResource LabelStyle}" /><TextBox x:Name="RegistrationInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="N° de série / VIN" Style="{StaticResource LabelStyle}" /><TextBox x:Name="VinInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Prix d’achat" Style="{StaticResource LabelStyle}" /><TextBox x:Name="PurchasePriceInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Date d’acquisition" Style="{StaticResource LabelStyle}" /><TextBox x:Name="AcquisitionDateInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Date de mise en service" Style="{StaticResource LabelStyle}" /><TextBox x:Name="ServiceDateInput" Style="{StaticResource InputStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Dernier contrôle" Style="{StaticResource LabelStyle}" /><TextBox x:Name="LastInspectionInput" Style="{StaticResource InputStyle}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="9" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12"><TextBlock Text="HISTORIQUE DU VÉHICULE" Foreground="#C8A24A" FontSize="11" /><TextBlock x:Name="HistoryCountLabel" HorizontalAlignment="Right" Foreground="#A9BBC0" /></Grid>
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Operation}" Click="HistoryItemClick" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,6" Background="#0B222D" Foreground="#E8EEF0" BorderBrush="#214451">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Operation.Kind}" Foreground="#C8A24A" />
                                            <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="#A9BBC0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Operation.Nature}" />
                                            <TextBlock Grid.Column="3" Text="{Binding DriverName}" HorizontalAlignment="Right" Foreground="#A9BBC0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHistoryLabel" Text="Aucun incident, trajet ou entretien enregistré." Foreground="#A9BBC0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12"><TextBlock Text="TÂCHES DE SUIVI ASSOCIÉES" Foreground="#C8A24A" FontSize="11" /><TextBlock x:Name="TaskCountLabel" HorizontalAlignment="Right" Foreground="#A9BBC0" /></Grid>
                        <ItemsControl x:Name="VehicleTasksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Display}" Tag="{Binding Task}" HorizontalContentAlignment="Left" Padding="9,7" Margin="0,0,0,5" Background="#0B222D" Foreground="#E8EEF0" BorderBrush="#214451" Click="TaskItemClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyTasksLabel" Text="Aucune tâche associée à ce véhicule." Foreground="#A9BBC0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Padding="14,8" Margin="0,0,8,0" Click="CloseClick" />
            <Button x:Name="SaveButton" Content="Enregistrer" Padding="14,8" Background="#C8A24A" Foreground="#06151D" BorderThickness="0" Visibility="Collapsed" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
