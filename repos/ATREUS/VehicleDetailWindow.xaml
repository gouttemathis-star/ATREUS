<Window x:Class="ATREUS.VehicleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiche véhicule"
        Icon="/ATREUS;component/Assets/atreus.ico"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#06151D"
        Foreground="#E8EEF0">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#091D27" />
        <SolidColorBrush x:Key="CardBrush" Color="#0B222D" />
        <SolidColorBrush x:Key="FieldBrush" Color="#06151D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#214451" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BBC0" />
        <SolidColorBrush x:Key="GoldBrush" Color="#C8A24A" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#E8EEF0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EditableFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E8EEF0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="HeaderEditableStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8EEF0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="FICHE ÉQUIPEMENT · DÉMONSTRATION" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBox x:Name="IdentifierInput" Text="{Binding Identifier}" Style="{StaticResource HeaderEditableStyle}" FontSize="22" FontWeight="Bold" Width="150" />
                    <TextBlock Text=" · " FontSize="22" FontWeight="Bold" />
                    <TextBox x:Name="DescriptionTextBlock" Text="{Binding Description}" Style="{StaticResource HeaderEditableStyle}" FontSize="22" FontWeight="Bold" Width="500" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Armée de Terre · " Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="EditButton" Content="Modifier" Padding="16,8" Margin="0,0,10,0" Background="{StaticResource GoldBrush}" Foreground="#06151D" BorderThickness="0" Click="EditClick" />
                <Button Content="Fermer" Padding="16,8" Background="#0B222D" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Click="CloseClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBox x:Name="StateInput" Text="{Binding State}" Style="{StaticResource EditableFieldStyle}" FontWeight="Bold" /><TextBlock Text="Statut" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBox x:Name="PlateInput" Text="{Binding Plate}" Style="{StaticResource EditableFieldStyle}" FontWeight="Bold" /><TextBlock Text="Plaque" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Grid.Column="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBox x:Name="MileageInput" Text="{Binding Mileage}" Style="{StaticResource EditableFieldStyle}" FontWeight="Bold" /><TextBlock Text="Kilométrage / heures" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" /></StackPanel></Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBox x:Name="BrandInput" Text="{Binding Brand}" Style="{StaticResource EditableFieldStyle}" FontWeight="Bold" /><TextBlock Text="Marque" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" /></StackPanel></Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBox x:Name="ModelInput" Text="{Binding Model}" Style="{StaticResource EditableFieldStyle}" FontWeight="Bold" /><TextBlock Text="Modèle" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" /></StackPanel></Border>
                    <Border Grid.Column="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBox x:Name="TypeInput" Text="{Binding Type}" Style="{StaticResource EditableFieldStyle}" FontWeight="Bold" /><TextBlock Text="Type" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" /></StackPanel></Border>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Informations administratives &amp; patrimoniales" FontSize="19" FontWeight="Bold" Margin="0,0,0,20" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CARTE GRISE" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="RegistrationInput" Text="{Binding Registration}" Style="{StaticResource EditableFieldStyle}" Margin="0,0,0,14" />
                                <TextBlock Text="DATE D'ACQUISITION" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="AcquisitionDateInput" Text="{Binding AcquisitionDate}" Style="{StaticResource EditableFieldStyle}" Margin="0,0,0,14" />
                                <TextBlock Text="FOURNISSEUR" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="SupplierInput" Text="{Binding Supplier}" Style="{StaticResource EditableFieldStyle}" Margin="0,0,0,14" />
                                <TextBlock Text="ÉNERGIE" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="EnergyInput" Text="{Binding Energy}" Style="{StaticResource EditableFieldStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="N° DE SÉRIE / VIN" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="VinInput" Text="{Binding Vin}" Style="{StaticResource EditableFieldStyle}" Margin="0,0,0,14" />
                                <TextBlock Text="PRIX D'ACHAT" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="PurchasePriceInput" Text="{Binding PurchasePrice}" Style="{StaticResource EditableFieldStyle}" Margin="0,0,0,14" />
                                <TextBlock Text="DATE DE MISE EN SERVICE" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="ServiceDateInput" Text="{Binding ServiceDate}" Style="{StaticResource EditableFieldStyle}" Margin="0,0,0,14" />
                                <TextBlock Text="PUISSANCE" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="PowerInput" Text="{Binding Power}" Style="{StaticResource EditableFieldStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="DERNIER CONTRÔLE" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="LastInspectionInput" Text="{Binding LastInspection}" Style="{StaticResource EditableFieldStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PROCHAIN CONTRÔLE" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="NextInspectionInput" Text="{Binding NextInspection}" Style="{StaticResource EditableFieldStyle}" /></StackPanel></Grid>
                        <StackPanel Width="520" HorizontalAlignment="Left" Margin="0,14,0,0"><TextBlock Text="LOCALISATION" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="LocationInput" Text="{Binding Location}" Style="{StaticResource EditableFieldStyle}" /></StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
