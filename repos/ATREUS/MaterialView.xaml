<UserControl x:Class="ATREUS.MaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBrush}">
    <Grid Margin="30,28,42,40">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="ATREUS · PARC &amp; MAINTENANCE" Foreground="{StaticResource GoldBrush}" FontSize="11" />
            <TextBlock Text="Parc de véhicules" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock Text="Véhicules terrestres, chauffeurs associés et état de disponibilité." Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="VÉHICULES RÉFÉRENCÉS" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                    <TextBlock x:Name="CountLabel" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="VehiclesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Vehicle}" HorizontalContentAlignment="Stretch" Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" Click="VehicleClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Vehicle.Identifier}" FontWeight="Bold" FontSize="15" /><TextBlock Text="{Binding Vehicle.Description}" Foreground="#A9BBC0" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="TYPE" Foreground="#C8A24A" FontSize="9" /><TextBlock Text="{Binding Vehicle.TypeDisplay}" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="MARQUE / MODÈLE" Foreground="{StaticResource GoldBrush}" FontSize="9" /><TextBlock Text="{Binding MakeModel}" Margin="0,4,0,0" /><TextBlock Text="{Binding Vehicle.Plate}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="CHAUFFEUR" Foreground="{StaticResource GoldBrush}" FontSize="9" /><TextBlock Text="{Binding DriverName}" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="ÉTAT" Foreground="{StaticResource GoldBrush}" FontSize="9" /><TextBlock Text="{Binding Vehicle.State}" Foreground="{Binding Vehicle.StateColor}" Margin="0,4,0,0" /></StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
