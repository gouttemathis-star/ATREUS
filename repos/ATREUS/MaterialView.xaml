<UserControl x:Class="ATREUS.MaterialView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#06151D">
    <Grid Margin="30,28,42,40">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22"><TextBlock Text="ATREUS · PARC &amp; MAINTENANCE" Foreground="#C8A24A" FontSize="11" /><TextBlock Text="Parc matériel" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" /><TextBlock Text="Vue complète des équipements référencés." Foreground="#A9BBC0" FontSize="13" /></StackPanel>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="ÉQUIPEMENTS" Foreground="#C8A24A" FontSize="11" /><TextBlock Text="{Binding Count, StringFormat={}{0} équipements}" Foreground="#A9BBC0" HorizontalAlignment="Right" /></Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Vehicles}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0B222D" BorderBrush="#214451" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Identifier}" FontWeight="Bold" FontSize="15" /><TextBlock Text="{Binding Description}" Foreground="#A9BBC0" FontSize="11" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TYPE" Foreground="#C8A24A" FontSize="9" /><TextBlock Text="{Binding Type}" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PLAQUE" Foreground="#C8A24A" FontSize="9" /><TextBlock Text="{Binding Plate}" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="ÉTAT" Foreground="#C8A24A" FontSize="9" /><TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" Margin="0,4,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
    </Grid>
</UserControl>
