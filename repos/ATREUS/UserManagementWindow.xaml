<UserControl x:Class="ATREUS.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#06151D" Foreground="#E8EEF0">
    <UserControl.Resources>
        <Style x:Key="AccountTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#B9C8CD" />
            <Setter Property="Background" Value="#081A23" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#214451" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#102B37" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8A24A" />
                                <Setter Property="Foreground" Value="#F2DFA8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#153340" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountListViewStyle" TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="#091D27" />
            <Setter Property="Foreground" Value="#E8EEF0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Foreground" Value="#E8EEF0" />
                        <Setter Property="Background" Value="#0B222D" />
                        <Setter Property="BorderBrush" Value="#214451" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="9,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                              Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#153340" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#214451" />
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#C8A24A" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="RowBorder" Property="Background" Value="#173744" />
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#C8A24A" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.58" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountGridViewColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Foreground" Value="#D8BD78" />
            <Setter Property="Background" Value="#102B37" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,10" />
            <Setter Property="BorderBrush" Value="#214451" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="AccountTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#091D27" />
            <Setter Property="BorderBrush" Value="#214451" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E8EEF0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AccountTabStyle}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="30,28,42,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ATREUS · ADMINISTRATION" Foreground="#C8A24A" FontSize="11" />
                <TextBlock Text="Comptes et autorisations" FontSize="26" FontWeight="Bold" Margin="0,6,0,3" />
                <TextBlock Text="Les comptes administrateurs ATREUS sont protégés. Les niveaux 3 et les comptes spéciaux autorisés gèrent les autres comptes."
                           Foreground="#A9BBC0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="+ Ajouter un compte" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="13,8" Background="#C8A24A" Foreground="#06151D"
                    BorderThickness="0" FontWeight="SemiBold" Click="AddClick" />
        </Grid>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1"
                CornerRadius="9" Padding="10">
            <TabControl x:Name="ManagementTabs" Style="{StaticResource AccountTabControlStyle}"
                        SelectionChanged="SelectionChanged">
                <TabItem x:Name="AccountsTab" Header="Comptes" Style="{StaticResource AccountTabStyle}">
                    <ListView x:Name="AccountsList" Style="{StaticResource AccountListViewStyle}"
                              SelectionChanged="SelectionChanged">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource AccountGridViewColumnHeaderStyle}">
                                <GridViewColumn Header="Identifiant" DisplayMemberBinding="{Binding UserName}" Width="160" />
                                <GridViewColumn Header="Nom affiché" DisplayMemberBinding="{Binding DisplayName}" Width="180" />
                                <GridViewColumn Header="Rôle" DisplayMemberBinding="{Binding Role}" Width="210" />
                                <GridViewColumn Header="Chauffeur associé" DisplayMemberBinding="{Binding DriverName}" Width="180" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem x:Name="ResetRequestsTab" Header="Demandes de réinitialisation" Style="{StaticResource AccountTabStyle}">
                    <ListView x:Name="ResetRequestsList" Style="{StaticResource AccountListViewStyle}"
                              SelectionChanged="SelectionChanged">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource AccountGridViewColumnHeaderStyle}">
                                <GridViewColumn Header="Identifiant demandé" DisplayMemberBinding="{Binding UserName}" Width="220" />
                                <GridViewColumn Header="Reçue le" DisplayMemberBinding="{Binding RequestedAt}" Width="170" />
                                <GridViewColumn Header="État" DisplayMemberBinding="{Binding Status}" Width="220" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="EditAccountButton" Content="Modifier les accès" Padding="14,8"
                    Margin="0,0,8,0" IsEnabled="False" Click="EditClick" />
            <Button x:Name="ResetPasswordButton" Content="Réinitialiser le mot de passe" Padding="14,8"
                    Margin="0,0,8,0" IsEnabled="False" Click="ResetPasswordClick" />
            <Button x:Name="DeleteAccountButton" Content="Supprimer le compte" Padding="14,8"
                    Margin="0,0,8,0" IsEnabled="False" Click="DeleteClick" />
            <Button x:Name="ProcessResetRequestButton" Content="Traiter la demande" Padding="14,8"
                    Margin="0,0,8,0" IsEnabled="False" Visibility="Collapsed" Click="ProcessResetRequestClick" />
            <Button x:Name="DismissResetRequestButton" Content="Ignorer la demande" Padding="14,8"
                    Margin="0,0,8,0" IsEnabled="False" Visibility="Collapsed" Click="DismissResetRequestClick" />
            <Button Content="Retour au tableau de bord" Padding="15,8" Click="CloseClick" />
        </StackPanel>
    </Grid>
</UserControl>
