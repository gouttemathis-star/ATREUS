<Window x:Class="ATREUS.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comptes et rôles ATREUS" Width="760" Height="590" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#06151D" Foreground="#E8EEF0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ATREUS · ADMINISTRATION" Foreground="#C8A24A" FontSize="11" />
                <TextBlock Text="Comptes et autorisations" FontSize="26" FontWeight="Bold" Margin="0,6,0,3" />
                <TextBlock Text="Les comptes conducteurs sont associés à une fiche chauffeur et n’accèdent qu’à leur planning."
                           Foreground="#A9BBC0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="+ Ajouter un compte" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="13,8" Background="#C8A24A" Foreground="#06151D"
                    BorderThickness="0" FontWeight="SemiBold" Click="AddClick" />
        </Grid>
        <Border Grid.Row="1" Background="#091D27" BorderBrush="#214451" BorderThickness="1"
                CornerRadius="9" Padding="10">
            <ListView x:Name="AccountsList" Background="Transparent" BorderThickness="0"
                      Foreground="#E8EEF0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Identifiant" DisplayMemberBinding="{Binding UserName}" Width="160" />
                        <GridViewColumn Header="Nom affiché" DisplayMemberBinding="{Binding DisplayName}" Width="180" />
                        <GridViewColumn Header="Rôle" DisplayMemberBinding="{Binding Role}" Width="210" />
                        <GridViewColumn Header="Chauffeur associé" DisplayMemberBinding="{Binding DriverName}" Width="180" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <Button Grid.Row="2" Content="Fermer" HorizontalAlignment="Right" Padding="15,8"
                Margin="0,15,0,0" Click="CloseClick" />
    </Grid>
</Window>
