<UserControl x:Class="ATREUS.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             Background="#06151D">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#091D27" />
        <SolidColorBrush x:Key="CardBrush" Color="#0B222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#214451" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BBC0" />
        <SolidColorBrush x:Key="GoldBrush" Color="#C8A24A" />
    </UserControl.Resources>
    <Grid Margin="30,28,42,40">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="ATREUS · CARTOGRAPHIE OPÉRATIONNELLE" Foreground="{StaticResource GoldBrush}" FontSize="11" /><TextBlock Text="Carte opérationnelle" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" /><TextBlock Text="Positionnement fictif des moyens du 12e Régiment Orion." Foreground="{StaticResource MutedBrush}" FontSize="13" /><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ConceptualModeButton" Content="Conceptuelle" Padding="12,6" Margin="0,0,8,0" Click="ConceptualModeClick" /><Button x:Name="SatelliteModeButton" Content="Satellite" Padding="12,6" Click="SatelliteModeClick" /></StackPanel></StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0A202A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Border Background="#0B252D">
                        <mapsui:MapControl x:Name="SatelliteMap" Background="#0B252D" Visibility="Collapsed" />
                    </Border>
                    <Canvas x:Name="MapCanvas" Background="#0B252D">
                        <Path Data="M 0,120 L 190,45 L 390,75 L 560,25 L 790,95 L 950,30 L 1150,130 L 1150,230 L 990,270 L 810,220 L 620,290 L 420,235 L 220,280 L 0,220 Z" Fill="#0D3036" /><Path Data="M 0,370 L 150,310 L 330,350 L 500,300 L 720,365 L 920,315 L 1150,370 L 1150,470 L 950,530 L 760,485 L 550,540 L 320,480 L 0,525 Z" Fill="#0D3036" /><Path Data="M 0,120 L 1150,500" Stroke="#24525A" StrokeThickness="2" /><Path Data="M 70,0 L 400,600" Stroke="#24525A" StrokeThickness="2" /><Path Data="M 720,0 L 540,600" Stroke="#24525A" StrokeThickness="2" /><Path Data="M 0,430 L 1150,90" Stroke="#24525A" StrokeThickness="2" />
                        <Border Canvas.Left="90" Canvas.Top="125" Width="285" Height="145" Background="#102B34" BorderBrush="#37636A" BorderThickness="1" CornerRadius="4"><StackPanel Margin="14"><TextBlock Text="BASE ORION" Foreground="#E5C35B" FontSize="12" FontWeight="Bold" /><TextBlock Text="Quartier général" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" /><Border Height="1" Background="#37636A" Margin="0,10" /><TextBlock Text="Bâtiment administratif" Foreground="#D8E2E5" FontSize="11" /><TextBlock Text="Poste de commandement" Foreground="#D8E2E5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Canvas.Left="520" Canvas.Top="90" Width="230" Height="110" Background="#102B34" BorderBrush="#37636A" BorderThickness="1" CornerRadius="4"><StackPanel Margin="14"><TextBlock Text="ZONE TECHNIQUE" Foreground="#E5C35B" FontSize="12" FontWeight="Bold" /><TextBlock Text="Ateliers et maintenance" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" /><TextBlock Text="Accès contrôlé" Foreground="#D8E2E5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Canvas.Left="410" Canvas.Top="350" Width="280" Height="115" Background="#102B34" BorderBrush="#37636A" BorderThickness="1" CornerRadius="4"><StackPanel Margin="14"><TextBlock Text="PARC VÉHICULES" Foreground="#E5C35B" FontSize="12" FontWeight="Bold" /><TextBlock Text="Stationnement principal" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" /><TextBlock Text="Entrée logistique · Porte Sud" Foreground="#D8E2E5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                        <Canvas x:Name="VehicleLayer" />
                    </Canvas>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#091D27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="16" Padding="10"><StackPanel><TextBlock Text="CARTE DE LA BASE" Foreground="{StaticResource GoldBrush}" FontSize="10" /><TextBlock Text="Vue tactique · Données fictives" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                    <TextBlock Text="© Esri, Maxar, Earthstar Geographics" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="White" Background="#9906151D" FontSize="10" Padding="5" Margin="0,0,8,8" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="MOYENS LOCALISÉS" Foreground="{StaticResource GoldBrush}" FontSize="11" /><TextBlock Text="{Binding Count, StringFormat={}{0} véhicules affichés}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18" /><TextBlock Text="LÉGENDE" Foreground="{StaticResource GoldBrush}" FontSize="10" /><StackPanel Orientation="Horizontal" Margin="0,10,0,18"><Ellipse Width="10" Height="10" Fill="#7CCB9B" /><TextBlock Text=" Disponible" Foreground="{StaticResource MutedBrush}" Margin="7,0,18,0" /><Ellipse Width="10" Height="10" Fill="#E2A05A" /><TextBlock Text=" Maintenance" Foreground="{StaticResource MutedBrush}" /></StackPanel><ItemsControl ItemsSource="{Binding Vehicles}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="VehicleListItemClick"><StackPanel><Grid><TextBlock Text="{Binding Identifier}" FontWeight="Bold" /><TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" HorizontalAlignment="Right" FontSize="11" /></Grid><TextBlock Text="{Binding Location}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
