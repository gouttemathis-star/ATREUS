<UserControl x:Class="ATREUS.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webview="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource PageBrush}">
    <Grid Margin="30,28,42,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="ATREUS · CARTOGRAPHIE OPÉRATIONNELLE" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                <TextBlock Text="ATREMAPS" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" />
                <TextBlock Text="Globe 3D satellite interactif · véhicules, chauffeurs, opérations et sites personnalisés." Foreground="{StaticResource MutedBrush}" FontSize="13" />
            </StackPanel>
            <Button Content="＋  Ajouter un site" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,10"
                    Background="{StaticResource GoldBrush}" Foreground="{StaticResource PageBrush}" BorderThickness="0" FontWeight="SemiBold" Click="AddSiteClick" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" ClipToBounds="True">
                <Grid>
                    <webview:WebView2 x:Name="GlobeBrowser" DefaultBackgroundColor="#06151D" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="14" Padding="9">
                        <TextBlock x:Name="GlobeStatus" Text="GLOBE · CHARGEMENT…" Foreground="{StaticResource GoldBrush}" FontSize="10" />
                    </Border>
                    <TextBlock Text="© Esri · Maxar · Earthstar Geographics · CesiumJS" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Foreground="White" Background="#AA06151D" FontSize="10" Padding="5" Margin="0,0,8,8" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="VUE D’ENSEMBLE" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                        <TextBlock x:Name="OverviewLabel" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10" />
                        <TextBlock Text="VÉHICULES LOCALISÉS" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                        <TextBlock x:Name="CountLabel" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,10" />
                        <ItemsControl x:Name="VehicleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Vehicle}" HorizontalContentAlignment="Stretch" Padding="9" Margin="0,0,0,6"
                                            Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Click="VehicleClick">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Vehicle.Identifier}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Vehicle.State}" Foreground="{Binding Vehicle.StateColor}" HorizontalAlignment="Right" FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding City}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Driver}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Vehicle.TypeDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding VehicleDescription}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding OperationalInfo}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,12" />
                        <TextBlock Text="SITES PERSONNALISÉS" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                        <TextBlock x:Name="SiteCountLabel" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,10" />
                        <ItemsControl x:Name="SiteList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0B222D" BorderBrush="#214451" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Tag="{Binding Site}" HorizontalContentAlignment="Left" Padding="2" Background="Transparent"
                                                    Foreground="{StaticResource TextBrush}" BorderThickness="0" Click="SiteClick">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Coordinates}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Tag="{Binding Site}" Content="✎" ToolTip="Modifier le site" Padding="7,3" Margin="3,0,0,0"
                                                    Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Click="EditSiteClick" />
                                            <Button Grid.Column="2" Tag="{Binding Site}" Content="×" ToolTip="Supprimer le site" Padding="7,3" Margin="3,0,0,0"
                                                    Background="{StaticResource CardBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource BorderBrush}" Click="DeleteSiteClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
