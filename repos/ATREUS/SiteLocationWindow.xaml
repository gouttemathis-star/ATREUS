<Window x:Class="ATREUS.SiteLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site personnalisé"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#06151D"
        Foreground="#E8EEF0">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="CARTOGRAPHIE OPÉRATIONNELLE" Foreground="#C8A24A" FontSize="11" />
            <TextBlock x:Name="WindowTitle" Text="Ajouter un site" FontSize="25" FontWeight="Bold" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Nom du lieu" Foreground="#A9BBC0" Margin="0,0,0,5" />
            <TextBox x:Name="NameInput" Padding="10,8" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Type de lieu" Foreground="#A9BBC0" Margin="0,0,0,5" />
                <ComboBox x:Name="KindInput" DisplayMemberPath="Display" SelectionChanged="KindSelectionChanged" Padding="8,6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Icône" Foreground="#A9BBC0" Margin="0,0,0,5" />
                <ComboBox x:Name="IconInput" DisplayMemberPath="Display" Padding="8,6" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Latitude (−90 à 90)" Foreground="#A9BBC0" Margin="0,0,0,5" />
                <TextBox x:Name="LatitudeInput" Padding="10,8" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Longitude (−180 à 180)" Foreground="#A9BBC0" Margin="0,0,0,5" />
                <TextBox x:Name="LongitudeInput" Padding="10,8" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,0,0,18">
            <TextBlock Text="Informations complémentaires" Foreground="#A9BBC0" Margin="0,0,0,5" />
            <TextBox x:Name="DetailsInput" Padding="10,8" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Padding="14,8" Margin="0,0,8,0" />
            <Button Content="Enregistrer" IsDefault="True" Padding="14,8" Background="#C8A24A" Foreground="#06151D"
                    BorderThickness="0" FontWeight="SemiBold" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
