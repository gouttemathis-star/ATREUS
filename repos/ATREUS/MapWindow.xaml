<Window x:Class="ATREUS.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATREUS - Carte opérationnelle"
        Icon="/ATREUS;component/Assets/atreus.ico"
        Width="1280"
        Height="820"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#06151D"
        Foreground="#E8EEF0">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#091D27" />
        <SolidColorBrush x:Key="CardBrush" Color="#0B222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#214451" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BBC0" />
        <SolidColorBrush x:Key="GoldBrush" Color="#C8A24A" />
        <SolidColorBrush x:Key="GreenBrush" Color="#7CCB9B" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#E2A05A" />
        <SolidColorBrush x:Key="RedBrush" Color="#E28076" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="ATREUS · CARTOGRAPHIE OPÉRATIONNELLE" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                <TextBlock Text="Carte opérationnelle" FontSize="32" FontWeight="Bold" Margin="0,7,0,3" />
                <TextBlock Text="Positionnement fictif des moyens du 12e Régiment Orion." Foreground="{StaticResource MutedBrush}" FontSize="13" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5"><TextBlock Text="DONNÉES DÉMO" Foreground="#D9B85A" FontSize="10" /></Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0A202A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="MapCanvas" Background="#0B252D">
                        <Path Data="M 0,120 L 190,45 L 390,75 L 560,25 L 790,95 L 950,30 L 1150,130 L 1150,230 L 990,270 L 810,220 L 620,290 L 420,235 L 220,280 L 0,220 Z" Fill="#0D3036" Opacity="0.9" />
                        <Path Data="M 0,370 L 150,310 L 330,350 L 500,300 L 720,365 L 920,315 L 1150,370 L 1150,470 L 950,530 L 760,485 L 550,540 L 320,480 L 0,525 Z" Fill="#0D3036" Opacity="0.85" />
                        <Path Data="M 0,120 L 1150,500" Stroke="#24525A" StrokeThickness="2" Opacity="0.8" />
                        <Path Data="M 70,0 L 400,600" Stroke="#24525A" StrokeThickness="2" Opacity="0.8" />
                        <Path Data="M 720,0 L 540,600" Stroke="#24525A" StrokeThickness="2" Opacity="0.8" />
                        <Path Data="M 0,430 L 1150,90" Stroke="#24525A" StrokeThickness="2" Opacity="0.8" />
                        <Border Canvas.Left="100" Canvas.Top="130" Width="300" Height="155" Background="#102B34" BorderBrush="#37636A" BorderThickness="1" CornerRadius="4" Opacity="0.95"><StackPanel Margin="14"><TextBlock Text="BASE ORION" Foreground="#E5C35B" FontSize="12" FontWeight="Bold" /><TextBlock Text="Quartier général" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" /><Border Height="1" Background="#37636A" Margin="0,10" /><TextBlock Text="Bâtiment administratif" Foreground="#D8E2E5" FontSize="11" /><TextBlock Text="Poste de commandement" Foreground="#D8E2E5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Canvas.Left="565" Canvas.Top="105" Width="230" Height="115" Background="#102B34" BorderBrush="#37636A" BorderThickness="1" CornerRadius="4" Opacity="0.95"><StackPanel Margin="14"><TextBlock Text="ZONE TECHNIQUE" Foreground="#E5C35B" FontSize="12" FontWeight="Bold" /><TextBlock Text="Ateliers et maintenance" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" /><TextBlock Text="Accès contrôlé" Foreground="#D8E2E5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Canvas.Left="455" Canvas.Top="370" Width="280" Height="120" Background="#102B34" BorderBrush="#37636A" BorderThickness="1" CornerRadius="4" Opacity="0.95"><StackPanel Margin="14"><TextBlock Text="PARC VÉHICULES" Foreground="#E5C35B" FontSize="12" FontWeight="Bold" /><TextBlock Text="Stationnement principal" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" /><TextBlock Text="Entrée logistique · Porte Sud" Foreground="#D8E2E5" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                    </Canvas>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#091D27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="16" Padding="10"><StackPanel><TextBlock Text="CARTE DE LA BASE" Foreground="{StaticResource GoldBrush}" FontSize="10" /><TextBlock Text="Vue tactique · Données fictives" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#091D27" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="16" Padding="9"><StackPanel Orientation="Horizontal"><Button Content="+" Width="28" Height="28" Background="#0B222D" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" /><TextBlock Text=" 100 m " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" /><Button Content="−" Width="28" Height="28" Background="#0B222D" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" /></StackPanel></Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="MOYENS LOCALISÉS" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Count, StringFormat={}{0} véhicules affichés}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18" />
                    <TextBlock Text="LÉGENDE" Foreground="{StaticResource GoldBrush}" FontSize="10" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,18"><Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" /><TextBlock Text=" Disponible" Foreground="{StaticResource MutedBrush}" Margin="7,0,18,0" /><Ellipse Width="10" Height="10" Fill="{StaticResource OrangeBrush}" /><TextBlock Text=" Maintenance" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                    <ItemsControl ItemsSource="{Binding Vehicles}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"><StackPanel><Grid><TextBlock Text="{Binding Identifier}" FontWeight="Bold" /><TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" HorizontalAlignment="Right" FontSize="11" /></Grid><TextBlock Text="{Binding Location}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
